# cuTile C++ requires C++20. Keep every host translation unit, including
# Abseil, on the same language-mode ABI as CUDA sources that include Abseil.
build --cxxopt=-std=c++20
# C++ allocation failures are fatal, including in build tools and CUDA host code.
build --cxxopt=-fno-exceptions
build --host_cxxopt=-fno-exceptions
build --@rules_cuda//cuda:copts=--no-exceptions
build --@rules_cuda//cuda:compiler=nvcc
build --@rules_cuda//cuda:archs=compute_90:sm_90
test --test_env=PLUTO_GPT2_TOKENIZER_DIR
test --test_env=PLUTO_FINEWEB_PARQUET_DIR
