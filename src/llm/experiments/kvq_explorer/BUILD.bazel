cc_test(
    name = "readout_test",
    size = "medium",
    srcs = ["readout_test.cc"],
    tags = ["requires-gpu"],
    deps = [
        ":readout",
        "//src/cuda:buffer",
        "//src/cuda:executor",
        "//src/cuda:page_locked_host_array",
        "//src/util:status_macros",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/types:span",
