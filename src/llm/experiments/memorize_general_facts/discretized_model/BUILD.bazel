load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Compile this entry point as an object in each generated executable, so its
# references pull the generated table libraries into the static link.
exports_files(["main.cc"])

cc_library(
    name = "capture",
    srcs = ["capture.cc"],
    hdrs = ["capture.h"],
    deps = [
        "//src/cuda:buffer",
        "//src/cuda:executor",
        "//src/cuda:page_locked_host_array",
        "//src/llm:extract_top1_ids",
        "//src/llm:layer",
        "//src/llm:layer_hooks",
        "//src/util:status_macros",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
        "@cuda//:cuda_runtime",
    ],
)

cc_binary(
    name = "capture_checkpoint",
    srcs = ["capture_main.cc"],
    deps = [
        ":capture",
        "//src/cuda:executor",
        "//src/dataset",
        "//src/dataset:compact_vocabulary",
        "//src/dataset:gpt2_detokenizer",
        "//src/dataset:gpt2_tokenizer",
        "//src/dataset:padded_line_dataset",
        "//src/llm:checkpoint",
        "//src/llm:gpt2",
        "//src/util:status_macros",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/memory",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "capture_test",
    srcs = ["capture_test.cc"],
    tags = ["requires-gpu"],
    deps = [
        ":capture",
        "//src/cuda:buffer",
        "//src/cuda:executor",
        "//src/cuda:page_locked_host_array",
        "//src/llm:gpt2",
        "//src/llm:layer",
        "//src/llm:layer_hooks",
        "//src/util:status_macros",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
        "@cuda//:cuda_runtime",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "runtime",
    srcs = ["runtime.cc"],
    hdrs = ["runtime.h"],
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "runtime_test",
    size = "small",
    srcs = ["runtime_test.cc"],
    deps = [
        ":runtime",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/types:span",
        "@googletest//:gtest_main",
    ],
)
