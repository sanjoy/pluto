load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Compile this entry point in each generated package, with that package's
# public model header and package-private CLI support declarations.
exports_files(["main.cc"])

cc_library(
    name = "runtime",
    srcs = ["runtime.cc"],
    hdrs = ["runtime.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/util:status_macros",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "runtime_test",
    size = "small",
    srcs = ["runtime_test.cc"],
    deps = [
        ":runtime",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/types:span",
        "@googletest//:gtest_main",
    ],
)

# This consumer is outside the generated package and uses only its public API.
cc_test(
    name = "generated_public_api_test",
    size = "small",
    srcs = ["generated_public_api_test.cc"],
    deps = [
        ":runtime",
        "//src/llm/experiments/memorize_general_facts/discretized_model/generated:model",
        "@googletest//:gtest_main",
    ],
)
