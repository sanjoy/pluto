load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "gpt2",
    srcs = ["gpt2.cc"],
    hdrs = ["gpt2.h"],
    copts = ["-std=c++20"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/cuda:executor",
        "//src/llm:attention",
        "//src/llm:combinators",
        "//src/llm:embedding",
        "//src/llm:fully_connected",
        "//src/llm:gelu",
        "//src/llm:layer",
        "//src/llm:norm",
        "//src/util:status_macros",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
    ],
)

cc_test(
    name = "gpt2_test",
    size = "medium",
    srcs = ["gpt2_test.cc"],
    tags = ["requires-gpu"],
    deps = [
        ":gpt2",
        "//src/cuda:buffer",
        "//src/cuda:executor",
        "//src/llm:layer",
        "@abseil-cpp//absl/status",
        "@cuda//:cuda_runtime",
        "@googletest//:gtest_main",
    ],
)
