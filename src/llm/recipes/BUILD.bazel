    name = "gpt2_shakespeare_llm_early_stop_test",
    size = "medium",
    timeout = "moderate",
    srcs = ["gpt2_shakespeare_llm.cc"],
    args = [
        "--mode=train_model",
        "--eval_batches=1",
        "--steps=10",
        "--train_until_loss=20",
    ],
    data = ["//testdata:shakespeare.txt"],
    tags = [
        "requires-gpu",
        "requires-tokenizer",
    ],
    deps = [
        ":activation_inspection",
        ":gpt2",
        ":gpt2_shakespeare_cli",
        ":sparse_autoencoder_dataset",
        "//src/cuda:buffer",
        "//src/cuda:executor",
        "//src/cuda:page_locked_host_array",
        "//src/dataset",
        "//src/dataset:detokenizer",
        "//src/dataset:gpt2_detokenizer",
        "//src/dataset:gpt2_tokenizer",
        "//src/dataset:tokenizer",
        "//src/llm:checkpoint",
        "//src/llm:cross_entropy_loss",
        "//src/llm:layer",
        "//src/llm:layer_hooks",
        "//src/llm:optimizer",
        "//src/llm:sampling",
        "//src/llm:sparse_autoencoder",
        "//src/llm:trainer",
        "//src/util:status_macros",
        "//src/util:tee_stream",
