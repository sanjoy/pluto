# Exercises loss-based early stopping without paying for a training step: the
# freshly initialized cross entropy is below this deliberately loose target.
cc_test(
    name = "shakespeare_llm_early_stop_test",
    size = "medium",
    timeout = "moderate",
    srcs = ["shakespeare_llm.cc"],
    args = [
        "--eval_batches=1",
        "--generation_tokens=0",
        "--interactive=false",
        "--steps=10",
        "--target_loss=20",
        "--train_until_loss=20",
    ],
    data = ["//testdata:shakespeare.txt"],
    tags = [
        "requires-gpu",
        "requires-tokenizer",
    ],
    deps = [
        ":checkpoint",
        ":layers",
        ":optimizer",
        ":trainer",
        "//src/dataset",
        "//src/common:status_macros",
        "//src/cuda:buffer",
        "//src/cuda:executor",
        "//src/dataset:detokenizer",
        "//src/dataset:tokenizer",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@cuda//:cuda_runtime",
